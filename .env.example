# Только локальная разработка. Замените каждую заглушку разным случайным значением.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_BOOTSTRAP_PASSWORD
ASHANA_MIGRATION_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_MIGRATION_PASSWORD
ASHANA_APP_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_RUNTIME_PASSWORD
ASHANA_WEB_PORT=8080
ASHANA_API_PORT=8000

# Начальные лимиты заказов; cutoff 15 минут выбран владельцем.
ASHANA_ORDER_CUTOFF_MINUTES=15
ASHANA_ORDER_SLOT_MINUTES=10
ASHANA_ORDER_SLOT_CAPACITY=10
ASHANA_ORDER_MAX_ACTIVE=2
ASHANA_ORDER_MAX_PORTIONS=10
ASHANA_ORDER_RESERVATION_SECONDS=300
# Telegram выключен при пустых значениях. Заполнять только локально.
ASHANA_TELEGRAM_BOT_TOKEN=
ASHANA_TELEGRAM_CHAT_ID=
